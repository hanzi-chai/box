{
	// Place your schema-box workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"import vue": {
		"scope": "javascript,typescript,vue",
		"prefix": "imref",
		"body": "import {ref} from 'vue';"
	},
	"import utils": {
		"scope": "javascript,typescript,vue",
		"prefix": "imutils",
		"body": "import * as utils from '@/libs/utils';"
	},
	"import libs": {
		"scope": "javascript,typescript,vue",
		"prefix": "imlibs",
		"body": "import * as ${1:libName} from '@/libs/${1:libName}';"
	},
	"import rambdax": {
		"scope": "javascript,typescript,vue",
		"prefix": "imrambdax",
		"body": "import * as R from 'rambdax';"
	},
	"import vueuse": {
		"scope": "javascript,typescript,vue",
		"prefix": "imvueuse",
		"body": "import { ${1:watchThrottled} } from '@vueuse/core';"
	},
	"Pinia Options Store Boilerplate": {
		"scope": "javascript,typescript",
		"prefix": "pinia-options",
		"body": [
			"import { defineStore, acceptHMRUpdate } from 'pinia'",
			"",
			"export const use${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}Store = defineStore('$TM_FILENAME_BASE', {",
			" state: () => ({",
			"   $0",
			" }),",
			" getters: {},",
			" actions: {},",
			"})",
			"",
			"if (import.meta.webpackHot) {",
			" import.meta.webpackHot.accept(acceptHMRUpdate(use${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}Store, import.meta.webpackHot))",
			"}"
		],
		"description": "Bootstrap the code needed for a Vue.js Pinia Options Store file"
	},
	"await import with webpack prefetch":{
		"scope": "javascript,typescript,vue",
		"prefix": "awaitimport",
		"body": "await import(/* webpackPrefetch: true */ '${1:moduleName}')"
	}
}