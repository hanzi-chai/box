{
    "compilerOptions": {
      "target": "ESNext",
      "jsxImportSource": "vue",
      "lib": ["DOM", "ESNext"],
      "useDefineForClassFields": true,
  
      /* modules */
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "paths": {
        "@/*": ["./src/*"]
      },
      "resolveJsonModule": true,
      "allowImportingTsExtensions": true,
      "allowJs": true,
  
      /* type checking */
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noEmit": true,
      "isolatedModules": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }
  